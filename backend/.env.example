# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=4000
NODE_ENV=development

# Secret used to sign the session-id cookie (cookie-parser). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
COOKIE_SECRET=replace_with_a_long_random_string

# Secret used by the CSRF double-submit token generator. Generate the same way as COOKIE_SECRET.
CSRF_SECRET=replace_with_a_long_random_string

# Server-side pepper mixed into every master-password hash/KDF operation.
# This is intentionally NOT stored in the database - it must live only here,
# so a stolen DB file alone is never enough to brute-force master passwords offline.
# Generate the same way as COOKIE_SECRET, then back it up somewhere safe (losing it
# permanently locks out every user's vault).
ENCRYPTION_PEPPER=replace_with_a_long_random_string

# How long an idle session (and its in-memory decryption key) stays valid, in minutes.
SESSION_TTL_MINUTES=60
